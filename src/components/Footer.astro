---
import FormattedText from "./i18n/FormattedText.astro";
const { class: id } = Astro.props;
---

<div style="height: 150px; overflow: hidden;">
  <svg
    viewBox="0 0 500 150"
    preserveAspectRatio="none"
    style="height: 100%; width: 100%;"
    ><path
      d="M-3.67,-5.41 C186.51,327.14 224.32,-157.38 501.97,75.50 L500.00,150.00 L0.00,150.00 Z"
      style="stroke: none; fill: #000;"></path></svg
  >
</div>
<div style="height: 250px; background-color: #000;" id={id}>
  <footer class="pie-pagina" id="Footer">
    <div class="grupo-1">
      <div class="box">
        <figure>
          <a href="">
            <img
              src="https://avatars.githubusercontent.com/u/102708414?v=4"
              alt="imagen de perfil"
            />
          </a>
        </figure>
      </div>
      <div class="box">
        <h2><FormattedText text={{ es: "Acerca de mí", en: "About Me" }} /></h2>
        <p>
          <FormattedText
            text={{
              es: "Especializado en el diseño y desarrollo de soluciones tecnológicas eficientes, robustas y escalables. Apasionado por las buenas prácticas, la resolución de problemas complejos y el trabajo colaborativo para impulsar productos digitales de alto impacto desde Medellín, Colombia.",
              en: "Specialized in the design and development of efficient, robust, and scalable technological solutions. Passionate about best practices, complex problem solving, and collaborative work to drive high-impact digital products from Medellín, Colombia.",
            }}
          />
        </p>
      </div>
      <div class="box">
        <h2><FormattedText text={{ es: "Contáctame", en: "Contact Me" }} /></h2>
        <div class="red-social">
          <a
            title="LinkedIn"
            href="https://www.linkedin.com/in/giovannyc-gil/"
            target="_blank"
            class="fa-brands fa-linkedin-in"></a>
          <a
            title="Instagram"
            href="https://www.instagram.com/giovannychica/"
            target="_blank"
            class="fa fa-instagram"></a>
          <a
            title="WhatsApp"
            href="https://wa.me/573043209834"
            target="_blank"
            class="fa-brands fa-whatsapp"></a>
          <a
            title="Github"
            href="https://github.com/GiovannyGil/"
            target="_blank"
            class="fa-brands fa-github"></a>
          <a
            title="Email"
            href="mailto:giovannydev01@gmail.com"
            target="_blank"
            class="fa-solid fa-envelope"></a>
        </div>
      </div>
    </div>
  </footer>
</div>
<script src="https://kit.fontawesome.com/58fd1432fe.js" crossorigin="anonymous"
></script>
<style>
  .pie-pagina {
    width: 100%;
    height: auto;
    background-color: #000;
  }

  .pie-pagina .grupo-1 {
    width: 100%;
    max-width: 1200%;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(
      3,
      1fr
    ); /*establece las columnas y el ancho, 3 columnas y todo el ancho*/
    grid-gap: 50px;
    padding: 45px 0px;
  }
  .pie-pagina .grupo-1 .box figure {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center; /*centrar horizontalmente*/
    align-items: center; /*centrar verticalmente*/
  }

  .pie-pagina .grupo-1 .box figure img {
    width: 250px;
    border-radius: 50%;
    transition: transform 0.5s ease; /* Agregado para la transición suave durante 0.5 segundos */
  }

  .pie-pagina .grupo-1 .box figure img:hover {
    transform: scale(1.15);
  }

  .pie-pagina .grupo-1 .box h2 {
    color: #fff;
    margin-bottom: 25px;
    font-size: 35px;
  }
  .pie-pagina .grupo-1 .box p {
    color: #efefef;
    margin-bottom: 10px;
  }
  .pie-pagina .grupo-1 .red-social a {
    display: inline-block;
    text-decoration: none;
    width: 45px;
    height: 45px;
    line-height: 45px;
    color: #fff;
    margin-right: 10px;
    text-align: center;
    transition: all 300ms ease;
  }
  .pie-pagina .grupo-1 .red-social a:hover {
    transform: scale(1.15);
    color: #f9532d;
  }
  .pie-pagina .grupo-2 {
    padding: 15px;
    text-align: center;
    background-color: #151414a6;
  }
  @media screen and (max-width: 800px) {
    /*para ponerlo responsive, visible bien en celular*/
    .pie-pagina .grupo-1 {
      width: 90%;
      grid-template-columns: repeat(
        1,
        1fr
      ); /*establece las columnas y el ancho, 3 columnas y todo el ancho*/
      grid-gap: 30px;
      padding: 35px 0px;
    }
  }
</style>

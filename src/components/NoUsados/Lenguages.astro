---

import { LENGUAGES } from '../models/Lenguages.model.js'
import "/public/css/cards/style.css"

// const {class: className, id} = Astro.props
---
<section class='stock-watchlist-container'>
    <h2 class="titulo">Lenguages</h2>
    <div id="stocks">
        {
            LENGUAGES.map(({Name, Level, Icon}) => (
                <article class="stock-row">
                     <Icon class="stock-avatar"></Icon>
                    <div class="stock-name">
                        <h3>{Name}</h3>
                    </div>
                    
                    <div class="stock-info">
                        <p class="change" style={`background-color: ${Level.color};`}>{Level.lvl}</p>
                    </div>
                </article>
            ))
        }
    </div>
</section>


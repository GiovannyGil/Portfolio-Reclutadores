---
import { TOOLS } from '../models/Tools.model.js'

import "../../public/css/cards/style.css"
---
<section class='stock-watchlist-container'>
    <h2 class="titulo">Tools</h2>
    <div id="stocks">
        {
            TOOLS.map(({Name, Level, Icon}) => (
                <article class="stock-row">
                    <Icon class="stock-avatar"></Icon>
                    <div class="stock-name">
                        <h3>{Name}</h3>
                    </div>
                    
                    <div class="stock-info">
                        <p class="change" style={`background-color: ${Level.color};`}>{Level.level}</p>
                    </div>
                </article>
            ))
        }
    </div>
</section>


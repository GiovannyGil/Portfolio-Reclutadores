---

<section id="Projects" class="projects-section">
  <h2 class="projects-title">
    <FormattedText text={{ es: "Proyectos y experiencias", en: "Projects and Experiences" }} />
  </h2>

  <!-- Tabs Categorias -->
  <div class="tabs-container" id="experience-tabs">
      <button data-category="empleo" class="category-tab active-tab">
        <FormattedText text={{ es: "Empleo", en: "Employment" }} />
      </button>
      <button data-category="freelance" class="category-tab inactive-tab">
        <FormattedText text={{ es: "Freelance", en: "Freelance" }} />
      </button>
  </div>

  <!-- Container Principal  -->
  <div class="principal-wrapper" id="principal-wrapper">
    {Object.entries(EXPERIENCES).map(([category, exps]) => (
      <div class={`category-section ${category}`} data-category={category} style={category === 'empleo' ? "display: block;" : "display: none;"}>
        
        {exps.length === 0 ? (
            <div class="empty-state">
                <p class="empty-state-text"><FormattedText text={{es: "Próximamente más proyectos", en: "More projects coming soon"}} /></p>
            </div>
        ) : (
            <div class="coverflow-root">
                <!-- 3D Coverflow Carousel -->
                <div class="coverflow-viewport">
                    <div class="coverflow-track">
                        {exps.map((exp, companyIdx) => (
                            <div 
                                data-company-index={companyIdx} 
                                class={`coverflow-card ${companyIdx === 0 ? 'coverflow-active' : ''}`}
                            >
                                <!-- Company Header inside card -->
                                <div class="card-company-header">
                                    <h3 class="card-company-title">{exp.company}</h3>
                                    <span class="card-company-date">{exp.date}</span>
                                    <span class="card-company-modalidad">{exp.modalidad}</span>
                                </div>

                                <!-- Projects content -->
                                <div class="card-projects-wrapper">
                                    {exp.projects.map((project, projectIdx) => (
                                        <div data-project-index={projectIdx} class="project-slide custom-scrollbar" style={projectIdx === 0 ? "opacity: 1; visibility: visible; position: relative; z-index: 10;" : "opacity: 0; visibility: hidden; position: absolute; z-index: 0;"}>
                                            
                                            <div class="project-header">
                                                <h4 class="project-title">
                                                    <FormattedText text={project.title} />
                                                </h4>
                                                <div class="project-meta">
                                                    {exp.projects.length > 1 && (
                                                        <div class="project-pagination">
                                                            <button class="prev-project p-nav" data-category={category} data-company-idx={companyIdx} aria-label="Anterior proyecto" style="display:flex; align-items:center; justify-content:center;">
                                                                <svg class="p-nav-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                                                            </button>
                                                            <span class="project-counter">{projectIdx + 1}/{exp.projects.length}</span>
                                                            <button class="next-project p-nav" data-category={category} data-company-idx={companyIdx} aria-label="Siguiente proyecto" style="display:flex; align-items:center; justify-content:center;">
                                                                <svg class="p-nav-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                                            </button>
                                                        </div>
                                                    )}
                                                    <span class="project-date">{project.date}</span>
                                                </div>
                                            </div>
                                            
                                            <div class="project-description">
                                                <FormattedText text={project.description} />
                                            </div>

                                            <div class="project-tags">
                                                {(project.tags ?? []).map(tag => {
                                                    const IconComponent = IconMap[tag];
                                                    return (
                                                        <span class="tag">
                                                            {IconComponent && <span class="tag-icon"><IconComponent /></span>}
                                                            {tag}
                                                        </span>
                                                    );
                                                })}
                                            </div>

                                            <div class="media-section">
                                                <div class="media-gallery custom-scrollbar">
                                                    {project.media.map((m, mIdx) => (
                                                        <button 
                                                            class={`media-item group ${m.style === 'mobile' ? 'mobile-style' : 'pc-style'}`}
                                                            data-action="open-lightbox"

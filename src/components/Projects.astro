    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
</style>

<script define:vars={{ EXPERIENCES }}>
  let currentCategory = 'empleo';

  const state = {};
  Object.keys(EXPERIENCES).forEach(cat => {
    state[cat] = {
      currentCompanyIdx: 0,
      projectIndices: new Array(EXPERIENCES[cat].length).fill(0)
    };
  });
  
  // ==== TABS ====
  const tabs = document.querySelectorAll('.category-tab');
  const sections = document.querySelectorAll('.category-section');

  tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
          const cat = e.currentTarget.dataset.category;
          if(cat === currentCategory) return;
          
          tabs.forEach(t => {
              if (t.dataset.category === cat) {
                  t.classList.remove('inactive-tab');
                  t.classList.add('active-tab');
              } else {
                  t.classList.add('inactive-tab');
                  t.classList.remove('active-tab');
              }
          });

          sections.forEach(sec => {
              if (sec.dataset.category === cat) {
                  sec.style.display = 'block';
                  requestAnimationFrame(() => sec.style.opacity = '1');
              } else {
                  sec.style.opacity = '0';
                  setTimeout(() => sec.style.display = 'none', 300);
              }
          });

          currentCategory = cat;
          updateCoverflow(cat);
      });
  });

  // ==== COVERFLOW 3D CAROUSEL ====
  function updateCoverflow(cat) {
    if (!EXPERIENCES[cat] || EXPERIENCES[cat].length === 0) return;
    const sec = document.querySelector(`.category-section.${cat}`);
    if (!sec) return;

    const cards = sec.querySelectorAll('.coverflow-card');
    const dots = sec.querySelectorAll('.coverflow-dot');
    const currentIdx = state[cat].currentCompanyIdx;
    const total = cards.length;

    cards.forEach((card, i) => {
      // Calculate relative position
      const diff = i - currentIdx;
      
      // Remove active class from all
      card.classList.remove('coverflow-active');
      
      if (diff === 0) {
        card.setAttribute('data-position', 'center');
        card.classList.add('coverflow-active');
      } else if (diff === -1 || (currentIdx === 0 && i === total - 1 && total > 2)) {
        card.setAttribute('data-position', 'left-1');
      } else if (diff === 1 || (currentIdx === total - 1 && i === 0 && total > 2)) {
        card.setAttribute('data-position', 'right-1');
      } else if (diff === -2 || (diff > 0 && diff >= total - 2)) {
        card.setAttribute('data-position', 'left-2');
      } else if (diff === 2 || (diff < 0 && diff <= -(total - 2))) {
        card.setAttribute('data-position', 'right-2');
      } else if (diff < 0) {
        card.setAttribute('data-position', 'hidden-left');
      } else {
        card.setAttribute('data-position', 'hidden-right');
      }
    });

    // Update dots
    dots.forEach((dot, i) => {
      if (i === currentIdx) {
        dot.classList.add('coverflow-dot-active');
      } else {
        dot.classList.remove('coverflow-dot-active');
      }
    });
  }

  // Navigation: Next/Prev company
  document.querySelectorAll('.coverflow-next').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const cat = e.currentTarget.closest('.category-section').dataset.category;
      const max = EXPERIENCES[cat].length;
      if (max === 0) return;
      state[cat].currentCompanyIdx = (state[cat].currentCompanyIdx + 1) % max;
      updateCoverflow(cat);
    });
  });

  document.querySelectorAll('.coverflow-prev').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const cat = e.currentTarget.closest('.category-section').dataset.category;
      const max = EXPERIENCES[cat].length;
      if (max === 0) return;
      state[cat].currentCompanyIdx = (state[cat].currentCompanyIdx - 1 + max) % max;
      updateCoverflow(cat);
    });
  });

  // Click on side cards to navigate to them
  document.querySelectorAll('.coverflow-card').forEach(card => {
    card.addEventListener('click', (e) => {
      const position = card.getAttribute('data-position');
      if (position === 'center') return; // Already active, let clicks through
      
      // Don't navigate if clicking inside a project's interactive elements
      if (e.target.closest('.p-nav') || e.target.closest('[data-action="open-lightbox"]')) return;
      
      const cat = card.closest('.category-section').dataset.category;
      const idx = parseInt(card.dataset.companyIndex);
      state[cat].currentCompanyIdx = idx;
      updateCoverflow(cat);
    });
  });

  // Dot navigation
  document.querySelectorAll('.coverflow-dot').forEach(dot => {
    dot.addEventListener('click', (e) => {
      const cat = e.currentTarget.closest('.category-section').dataset.category;
      const idx = parseInt(e.currentTarget.dataset.dotIndex);
      state[cat].currentCompanyIdx = idx;
      updateCoverflow(cat);
    });
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    // Don't interfere with lightbox
    if (document.getElementById('lightbox').classList.contains('active')) return;
    
    if (e.key === 'ArrowLeft') {
      const max = EXPERIENCES[currentCategory].length;
      if (max === 0) return;
      state[currentCategory].currentCompanyIdx = (state[currentCategory].currentCompanyIdx - 1 + max) % max;
      updateCoverflow(currentCategory);
    } else if (e.key === 'ArrowRight') {
      const max = EXPERIENCES[currentCategory].length;
      if (max === 0) return;
      state[currentCategory].currentCompanyIdx = (state[currentCategory].currentCompanyIdx + 1) % max;
      updateCoverflow(currentCategory);
    }
  });

  // Touch/Swipe support for mobile
  document.querySelectorAll('.coverflow-viewport').forEach(viewport => {
    let touchStartX = 0;
    let touchEndX = 0;
    const minSwipeDistance = 50;

    viewport.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    viewport.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      const cat = viewport.closest('.category-section').dataset.category;
      const max = EXPERIENCES[cat].length;
      if (max <= 1) return;

      if (Math.abs(diff) > minSwipeDistance) {
        if (diff > 0) {
          // Swipe left -> next
          state[cat].currentCompanyIdx = (state[cat].currentCompanyIdx + 1) % max;
        } else {
          // Swipe right -> prev
          state[cat].currentCompanyIdx = (state[cat].currentCompanyIdx - 1 + max) % max;
        }
        updateCoverflow(cat);
      }
    }, { passive: true });
  });

  // ==== PROJECT NAVIGATION ====
  document.querySelectorAll('.next-project').forEach(btn => {
      btn.addEventListener('click', (e) => {
          e.stopPropagation(); // Prevent coverflow card click
          const cat = btn.dataset.category;
          const cIdx = parseInt(btn.dataset.companyIdx);
          const max = EXPERIENCES[cat][cIdx].projects.length;
          state[cat].projectIndices[cIdx] = (state[cat].projectIndices[cIdx] + 1) % max;
          updateProjectSlide(cat, cIdx);
          updateProjectCounter(btn.closest('.project-slide').querySelector('.project-counter').parentNode, state[cat].projectIndices[cIdx] + 1, max);
      });
  });

  document.querySelectorAll('.prev-project').forEach(btn => {
      btn.addEventListener('click', (e) => {
          e.stopPropagation(); // Prevent coverflow card click
          const cat = btn.dataset.category;
          const cIdx = parseInt(btn.dataset.companyIdx);
          const max = EXPERIENCES[cat][cIdx].projects.length;
          state[cat].projectIndices[cIdx] = (state[cat].projectIndices[cIdx] - 1 + max) % max;
          updateProjectSlide(cat, cIdx);
          updateProjectCounter(btn.closest('.project-slide').querySelector('.project-counter').parentNode, state[cat].projectIndices[cIdx] + 1, max);
      });
  });

  function updateProjectCounter(container, current, max) {
      if(!container) return;
      const counter = container.querySelector('.project-counter');
      if(counter) counter.textContent = `${current}/${max}`;
  }

  function updateProjectSlide(cat, companyIdx) {
      const sec = document.querySelector(`.category-section.${cat}`);
      if(!sec) return;
      const companyContainer = sec.querySelector(`.coverflow-card[data-company-index="${companyIdx}"]`);
      if(!companyContainer) return;

      const slides = companyContainer.querySelectorAll('.project-slide');
      const current = state[cat].projectIndices[companyIdx];
      
      slides.forEach((slide, idx) => {
          if (idx === current) {
              slide.style.visibility = 'visible';
              slide.style.opacity = '1';
              slide.style.position = 'relative';
              slide.style.zIndex = '10';
          } else {
              slide.style.opacity = '0';
              slide.style.position = 'absolute';
              slide.style.zIndex = '0';
              setTimeout(() => { if (idx !== state[cat].projectIndices[companyIdx]) slide.style.visibility = 'hidden'; }, 300);
          }
      });
  }

  // ==== LIGHTBOX ====
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lbNext = document.getElementById('lb-next');
  const lbPrev = document.getElementById('lb-prev');
  const lbClose = document.getElementById('close-lightbox');

  let lbCat = 'empleo';
  let lbCompanyIdx = 0;
  let lbProjectIdx = 0;
  let lbMediaIdx = 0;

  function openLightbox(cat, cIdx, pIdx, mIdx) {
      lbCat = cat;
      lbCompanyIdx = cIdx;
      lbProjectIdx = pIdx;
      lbMediaIdx = mIdx;
      updateLightboxContent();
      
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
      setTimeout(() => { lightboxImg.src = ''; }, 300);
  }

  function updateLightboxContent() {
      let mParams;
      try { mParams = EXPERIENCES[lbCat][lbCompanyIdx].projects[lbProjectIdx].media; } catch(e) { return ; }
      if (!mParams || !mParams[lbMediaIdx]) return;
      const media = mParams[lbMediaIdx];
      if (media.type === 'image') {
          lightboxImg.src = media.src;
      }
  }

  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-action="open-lightbox"]');
    if (trigger) {
        e.stopPropagation(); // Prevent coverflow card click
        const cat = trigger.dataset.category;
        const cIdx = parseInt(trigger.dataset.companyIdx);
        const pIdx = parseInt(trigger.dataset.projectIdx);
        const mIdx = parseInt(trigger.dataset.mediaIdx);
        openLightbox(cat, cIdx, pIdx, mIdx);
    }
  });

  lbClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
      if(e.target === lightbox || e.target.id === 'lightbox-content') closeLightbox();
  });

  lbNext.addEventListener('click', (e) => {
      e.stopPropagation();
      let mParams;
      try { mParams = EXPERIENCES[lbCat][lbCompanyIdx].projects[lbProjectIdx].media; } catch(e) { return; }
      if(!mParams) return;
      lbMediaIdx = (lbMediaIdx + 1) % mParams.length;
      updateLightboxContent();
  });

  lbPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      let mParams;
      try { mParams = EXPERIENCES[lbCat][lbCompanyIdx].projects[lbProjectIdx].media; } catch(e) { return; }
      if(!mParams) return;
      lbMediaIdx = (lbMediaIdx - 1 + mParams.length) % mParams.length;
      updateLightboxContent();
  });

  document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') lbNext.click();
      if (e.key === 'ArrowLeft') lbPrev.click();
  });
  
  // ==== DRAG TO SCROLL for galleries ====
  function initDragScroll() {
    const galleries = document.querySelectorAll('.media-gallery');
    galleries.forEach(gallery => {
        let isDown = false;
        let startX;
        let scrollLeft;

        gallery.addEventListener('mousedown', (e) => {
            isDown = true;
            gallery.style.cursor = 'grabbing';
            startX = e.pageX - gallery.offsetLeft;
            scrollLeft = gallery.scrollLeft;
        });

        gallery.addEventListener('mouseleave', () => {
            isDown = false;
            gallery.style.cursor = 'grab';
        });

        gallery.addEventListener('mouseup', () => {
            isDown = false;
            gallery.style.cursor = 'grab';
        });

        gallery.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - gallery.offsetLeft;
            const walk = (x - startX) * 2;
            gallery.scrollLeft = scrollLeft - walk;
        });
    });
  }

  // Initialize everything
  initDragScroll();
  Object.keys(EXPERIENCES).forEach(cat => updateCoverflow(cat));
</script>

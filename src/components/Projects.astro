<script define:vars={{ EXPERIENCES }}>
  let currentCategory = 'empleo';

  const state = {};
  Object.keys(EXPERIENCES).forEach(cat => {
    state[cat] = {
      currentCompanyIdx: 0,
      projectIndices: new Array(EXPERIENCES[cat].length).fill(0)
    };
  });
  
  const tabs = document.querySelectorAll('.category-tab');
  const sections = document.querySelectorAll('.category-section');

  tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
          const cat = e.currentTarget.dataset.category;
          if(cat === currentCategory) return;
          
          tabs.forEach(t => {
              if (t.dataset.category === cat) {
                  t.classList.remove('inactive-tab');
                  t.classList.add('active-tab');
              } else {
                  t.classList.add('inactive-tab');
                  t.classList.remove('active-tab');
              }
          });

          sections.forEach(sec => {
              if (sec.dataset.category === cat) {
                  sec.style.display = 'block';
                  requestAnimationFrame(() => sec.style.opacity = '1');
              } else {
                  sec.style.opacity = '0';
                  setTimeout(() => sec.style.display = 'none', 300);
              }
          });

          currentCategory = cat;
          updateCompany(cat);
      });
  });

  function updateCompany(cat) {
    if(!EXPERIENCES[cat] || EXPERIENCES[cat].length === 0) return;
    const sec = document.querySelector(`.category-section.${cat}`);
    if(!sec) return;
    
    const slides = sec.querySelectorAll('.company-slide');
    const title = sec.querySelector('.company-title');
    const date = sec.querySelector('.company-date');
    
    const idx = state[cat].currentCompanyIdx;
    
    slides.forEach((slide, i) => {
        if(i === idx) {
            slide.style.visibility = 'visible';
            slide.style.opacity = '1';
            slide.style.zIndex = '10';
        } else {
            slide.style.opacity = '0';
            slide.style.zIndex = '0';
            setTimeout(() => { if(i !== state[cat].currentCompanyIdx) slide.style.visibility = 'hidden'; }, 300);
        }
    });

    if (EXPERIENCES[cat][idx]) {
        if(title) title.textContent = EXPERIENCES[cat][idx].company;
        if(date) date.textContent = EXPERIENCES[cat][idx].date;
    }
  }

  document.querySelectorAll('.next-company').forEach(btn => {
      btn.addEventListener('click', (e) => {
          const cat = e.currentTarget.closest('.category-section').dataset.category;
          const max = EXPERIENCES[cat].length;
          if(max === 0) return;
          state[cat].currentCompanyIdx = (state[cat].currentCompanyIdx + 1) % max;
          updateCompany(cat);
      });
  });

  document.querySelectorAll('.prev-company').forEach(btn => {
      btn.addEventListener('click', (e) => {
          const cat = e.currentTarget.closest('.category-section').dataset.category;
          const max = EXPERIENCES[cat].length;
          if(max === 0) return;
          state[cat].currentCompanyIdx = (state[cat].currentCompanyIdx - 1 + max) % max;
          updateCompany(cat);
      });
  });

  document.querySelectorAll('.next-project').forEach(btn => {
      btn.addEventListener('click', (e) => {
          const cat = btn.dataset.category;
          const cIdx = parseInt(btn.dataset.companyIdx);
          const max = EXPERIENCES[cat][cIdx].projects.length;
          state[cat].projectIndices[cIdx] = (state[cat].projectIndices[cIdx] + 1) % max;
          updateProjectSlide(cat, cIdx);
          updateProjectCounter(btn.closest('.project-slide').querySelector('.project-counter').parentNode, state[cat].projectIndices[cIdx] + 1, max);
      });
  });

  document.querySelectorAll('.prev-project').forEach(btn => {
      btn.addEventListener('click', (e) => {
          const cat = btn.dataset.category;
          const cIdx = parseInt(btn.dataset.companyIdx);
          const max = EXPERIENCES[cat][cIdx].projects.length;
          state[cat].projectIndices[cIdx] = (state[cat].projectIndices[cIdx] - 1 + max) % max;
          updateProjectSlide(cat, cIdx);
          updateProjectCounter(btn.closest('.project-slide').querySelector('.project-counter').parentNode, state[cat].projectIndices[cIdx] + 1, max);
      });
  });

  function updateProjectCounter(container, current, max) {
      if(!container) return;
      const counter = container.querySelector('.project-counter');
      if(counter) counter.textContent = `${current}/${max}`;
  }

  function updateProjectSlide(cat, companyIdx) {
      const sec = document.querySelector(`.category-section.${cat}`);
      if(!sec) return;
      const companyContainer = sec.querySelector(`.company-slide[data-company-index="${companyIdx}"]`);
      if(!companyContainer) return;

      const slides = companyContainer.querySelectorAll('.project-slide');
      const current = state[cat].projectIndices[companyIdx];
      
      slides.forEach((slide, idx) => {
          if (idx === current) {
              slide.style.visibility = 'visible';
              slide.style.opacity = '1';
              slide.style.position = 'relative';
              slide.style.zIndex = '10';
          } else {
              slide.style.opacity = '0';
              slide.style.position = 'absolute';
              slide.style.zIndex = '0';
              setTimeout(() => { if (idx !== state[cat].projectIndices[companyIdx]) slide.style.visibility = 'hidden'; }, 300);
          }
      });
  }

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lbNext = document.getElementById('lb-next');
  const lbPrev = document.getElementById('lb-prev');
  const lbClose = document.getElementById('close-lightbox');

  let lbCat = 'empleo';
  let lbCompanyIdx = 0;
  let lbProjectIdx = 0;
  let lbMediaIdx = 0;

  function openLightbox(cat, cIdx, pIdx, mIdx) {
      lbCat = cat;
      lbCompanyIdx = cIdx;
      lbProjectIdx = pIdx;
      lbMediaIdx = mIdx;
      updateLightboxContent();
      
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
      setTimeout(() => { lightboxImg.src = ''; }, 300);
  }

  function updateLightboxContent() {
      let mParams;
      try { mParams = EXPERIENCES[lbCat][lbCompanyIdx].projects[lbProjectIdx].media; } catch(e) { return ; }
      if (!mParams || !mParams[lbMediaIdx]) return;
      const media = mParams[lbMediaIdx];
      if (media.type === 'image') {
          lightboxImg.src = media.src;
      }
  }

  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-action="open-lightbox"]');
    if (trigger) {
        const cat = trigger.dataset.category;
        const cIdx = parseInt(trigger.dataset.companyIdx);
        const pIdx = parseInt(trigger.dataset.projectIdx);
        const mIdx = parseInt(trigger.dataset.mediaIdx);
        openLightbox(cat, cIdx, pIdx, mIdx);
    }
  });

  lbClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
      if(e.target === lightbox || e.target.id === 'lightbox-content') closeLightbox();
  });

  lbNext.addEventListener('click', (e) => {
      e.stopPropagation();
      let mParams;
      try { mParams = EXPERIENCES[lbCat][lbCompanyIdx].projects[lbProjectIdx].media; } catch(e) { return; }
      if(!mParams) return;
      lbMediaIdx = (lbMediaIdx + 1) % mParams.length;
      updateLightboxContent();
  });

  lbPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      let mParams;
      try { mParams = EXPERIENCES[lbCat][lbCompanyIdx].projects[lbProjectIdx].media; } catch(e) { return; }
      if(!mParams) return;
      lbMediaIdx = (lbMediaIdx - 1 + mParams.length) % mParams.length;
      updateLightboxContent();
  });

  document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') lbNext.click();
      if (e.key === 'ArrowLeft') lbPrev.click();
  });
  
  // Drag to scroll functionality for galleries
  function initDragScroll() {
    const galleries = document.querySelectorAll('.media-gallery');
    galleries.forEach(gallery => {
        let isDown = false;
        let startX;
        let scrollLeft;

        gallery.addEventListener('mousedown', (e) => {
            isDown = true;
            gallery.style.cursor = 'grabbing';
            startX = e.pageX - gallery.offsetLeft;
            scrollLeft = gallery.scrollLeft;
        });

        gallery.addEventListener('mouseleave', () => {
            isDown = false;
            gallery.style.cursor = 'grab';
        });

        gallery.addEventListener('mouseup', () => {
            isDown = false;
            gallery.style.cursor = 'grab';
        });

        gallery.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - gallery.offsetLeft;
            const walk = (x - startX) * 2;
            gallery.scrollLeft = scrollLeft - walk;
        });
    });
  }

  // Initialize
  initDragScroll();
  
  Object.keys(EXPERIENCES).forEach(cat => updateCompany(cat));
</script>

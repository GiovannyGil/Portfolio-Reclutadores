---

<section id="Projects" class="projects-section">
  <h2 class="projects-title">
    <FormattedText text={{ es: "Proyectos y experiencias", en: "Projects and Experiences" }} />
  </h2>

  <!-- Tabs Categorias -->
  <div class="tabs-container" id="experience-tabs">
      <button data-category="empleo" class="category-tab active-tab">
        <FormattedText text={{ es: "Empleo", en: "Employment" }} />
      </button>
      <button data-category="freelance" class="category-tab inactive-tab">
        <FormattedText text={{ es: "Freelance", en: "Freelance" }} />
      </button>
  </div>

  <!-- Container Principal  -->
  <div class="principal-wrapper" id="principal-wrapper">
    {Object.entries(EXPERIENCES).map(([category, exps]) => (
      <div class={`category-section ${category}`} data-category={category} style={category === 'empleo' ? "display: block;" : "display: none;"}>
        
        {exps.length === 0 ? (
            <div class="empty-state">
                <p class="empty-state-text"><FormattedText text={{es: "Próximamente más proyectos", en: "More projects coming soon"}} /></p>
            </div>
        ) : (
            <div class="relative w-full">
                <!-- Título de la Empresa -->
                <div class="company-header">
                    <h3 class="company-title">
                        {exps[0].company}
                    </h3>
                    <span class="company-date">
                        {exps[0].date}
                    </span>
                </div>

                <div class="carousel-wrapper">
                    <!-- Botón Anterior Empresa -->
                    <button class="prev-company nav-btn group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="nav-icon prev-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    </button>

                    <!-- Card Container -->
                    <div class="company-container">
                        {exps.map((exp, companyIdx) => (
                            <div data-company-index={companyIdx} class="company-slide" style={companyIdx === 0 ? "opacity: 1; visibility: visible; z-index: 10;" : "opacity: 0; visibility: hidden; z-index: 0;"}>
                                <div class="projects-wrapper">
                                    {exp.projects.map((project, projectIdx) => (
                                        <div data-project-index={projectIdx} class="project-slide custom-scrollbar" style={projectIdx === 0 ? "opacity: 1; visibility: visible; position: relative; z-index: 10;" : "opacity: 0; visibility: hidden; position: absolute; z-index: 0;"}>
                                            
                                            <div class="project-header">
                                                <h4 class="project-title">
                                                    <FormattedText text={project.title} />
                                                </h4>
                                                <div class="project-meta">
                                                    {exp.projects.length > 1 && (
                                                        <div class="project-pagination">
                                                            <button class="prev-project p-nav" data-category={category} data-company-idx={companyIdx}>
                                                                <svg class="p-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                                                            </button>
                                                            <span class="project-counter">{projectIdx + 1}/{exp.projects.length}</span>
                                                            <button class="next-project p-nav" data-category={category} data-company-idx={companyIdx}>
                                                                <svg class="p-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                                            </button>
                                                        </div>
                                                    )}
                                                    <span class="project-date">{project.date}</span>
                                                </div>
                                            </div>
                                            
                                            <div class="project-description">
                                                <FormattedText text={project.description} />
                                            </div>

                                            <div class="project-tags">
                                                {(project.tags ?? []).map(tag => (
                                                    <span class="tag">
                                                        {tag}
                                                    </span>
                                                ))}
                                            </div>

                                            <div class="media-section">
                                                <div class="media-gallery custom-scrollbar">
                                                    {project.media.map((m, mIdx) => (
                                                        <button 
                                                            class={`media-item group ${m.style === 'mobile' ? 'mobile-style' : 'pc-style'}`}
                                                            data-action="open-lightbox"
                                                            data-category={category}
                                                            data-company-idx={companyIdx}
                                                            data-project-idx={projectIdx}
                                                            data-media-idx={mIdx}
                                                        >
                                                            <img src={m.src} class="media-img" />
                                                            <div class="media-overlay">
                                                                <svg class="media-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                                            </div>
                                                        </button>
                                                    ))}
                                                </div>
                                            </div>

                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>

                    <!-- Botón Siguiente Empresa -->
                    <button class="next-company nav-btn group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="nav-icon next-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </button>
                </div>
            </div>
        )}
      </div>
    ))}
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox">
      <button id="close-lightbox" class="lb-close">
        <svg class="lb-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <button id="lb-prev" class="lb-nav-btn lb-prev-btn">
        <svg class="lb-icon-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      
      <button id="lb-next" class="lb-nav-btn lb-next-btn">
        <svg class="lb-icon-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>

      <div class="lb-content-wrapper">
          <div id="lightbox-content" class="lb-content">
              <img id="lightbox-img" src="" class="lb-img" />
          </div>
      </div>
  </div>
</section>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(59, 130, 246, 0.3);
    border-radius: 10px;
    transition: all 0.3s;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(59, 130, 246, 0.6);
  }
  
  /* Media gallery adjustments */
  .media-gallery {
    cursor: grab;
    user-select: none;
  }
  .media-gallery:active {
    cursor: grabbing;
  }

  .projects-section {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 6rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  @media (min-width: 640px) { .projects-section { padding-left: 1.5rem; padding-right: 1.5rem; } }
  @media (min-width: 768px) { .projects-section { max-width: 64rem; } }
  @media (min-width: 1024px) { .projects-section { max-width: 80rem; } }

  .projects-title {
    font-size: 2.25rem;
    line-height: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 4rem;
    color: #ffffff;
  }
  @media (prefers-color-scheme: dark) { .projects-title { color: #f3f4f6; } }

  .tabs-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
    width: 100%;
  }

  .category-tab {
    padding: 0.5rem 1.5rem;
    border-radius: 9999px;
    font-weight: 600;
    transition: all 150ms ease-in-out;
    border: 1px solid transparent;
  }
  .active-tab {

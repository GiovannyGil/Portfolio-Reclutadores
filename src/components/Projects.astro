  }

  /* Each company card in the coverflow */
  .coverflow-card {
    position: absolute;
    top: 0;
    left: 50%;
    width: 65%;
    max-width: 900px;
    height: 100%;
    background: rgba(17, 24, 39, 0.85);
    backdrop-filter: blur(16px);

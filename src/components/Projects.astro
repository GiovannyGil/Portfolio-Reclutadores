---
// list of projects
const userLang = navigator.language.startsWith("es") ? "es" : "en";
import { translations } from "./models/idioma.js";

const PROJECTS = [
  {
    title: translations[userLang]?.descripcionProyectos?.proyecto3?.titulo,
    description:
      translations[userLang]?.descripcionProyectos?.proyecto3?.descripcion,
    image: "/projects/FACE.webp",
    date: "17/07/2023 - 17/01/2024",
    tags: ["Python", "OpenCV", "MediaPipe", "Gpio", "SQLite3"],
  },
  {
    title: translations[userLang]?.descripcionProyectos?.proyecto2?.titulo,
    description:
      translations[userLang]?.descripcionProyectos?.proyecto2?.descripcion,
    image: "/projects/ClasificacionGal.webp",
    date: "17/07/2023 - 17/01/2024",
    tags: ["Python", "TensorFlow", "Keras", "Numpy", "Matplotlib"],
  },
  {
    title: translations[userLang]?.descripcionProyectos?.proyecto1?.titulo,
    description:
      translations[userLang]?.descripcionProyectos?.proyecto1?.descripcion,
    image: "/projects/sgnan.webp",
    date: "01/02/2023 - 01/06/2023",
    tags: [
      "PHP",
      "Laravel",
      "JavaScript",
      "HTML",
      "CSS",
      "Bootstrap5",
      "MySQL",
    ],
  },
];

// const {class: className, id} = Astro.props
---

<h2
  class="text-4xl font-bold text-white-800 dark:text-gray-100 text-center mb-4"
>
  {translations[userLang]?.titulos?.projects}
</h2>
<section
  class="scroll-m-20 w-full mx-auto container lg:max-w-6xl md:max-w-4xl flex items-center mb-3 gap-x-3 text-white/80 dark:text-white"
>
  <div class="flex flex-col gap-y-16 w-full" id="Projects">
    {
      PROJECTS.map(({ title, description, image, date, tags }) => (
        <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 w-full">
          <div class="w-full md:w-1/2 lg:w-1/3">
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
              <img
                alt="imagen"
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            </div>
          </div>

          <div class="w-full md:w-1/2 lg:w-2/3 md:max-w-lg">
            <h3 class="text-2xl font-bold text-white-800 dark:text-gray-100">
              {title}
            </h3>
            <div class="mt-2 text-white-700 dark:text-gray-400">{date}</div>
            <div class="flex flex-wrap mt-2">
              <ul class="flex gap-x-2 flex-row">
                {tags.map((tag) => (
                  <li>
                    <span class="flex gap-x-2 rounded-full text-xs py-1 px-2 bg-blue-500 text-black font-semibold">
                      {tag}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="mt-2 text-white-700 dark:text-gray-400">
                {description}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <slot />
</section>

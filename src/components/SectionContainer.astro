---
const { class: id } = Astro.props;
import "/public/css/home/style.css";
import FormattedText from "./i18n/FormattedText.astro";
---

<section class="container" id="Home">
  <div class="main">
    <div class="rounding-sec">
      <div class="big-circle">
        <div class="icon-block">
          <!-- <JS /> -->
          <img src="/icon/js.png" alt="" class="img-w" />
        </div>
        <div class="icon-block">
          <img src="/icon/ts.png" alt="" class="img-w" />
        </div>
        <div class="icon-block">
          <img src="/icon/kotlin.png" alt="" class="img-w" />
        </div>
        <div class="icon-block">
          <img src="/icon/sql.png" alt="" class="img-w" />
        </div>
      </div>
      <div class="images">
        <img
          src="https://avatars.githubusercontent.com/u/102708414?v=4"
          alt=""
          class="img-w"
        />
      </div>
    </div>
    <div class="detail">
      <h3 class="">
        <FormattedText text={{ es: "¡Hola!, Yo soy", en: "Hello! I am" }} />
      </h3>
      <section class="efecto">
        <h1 class="top" style="color:#f9532d;"><span>Giovanny</span> Chica</h1>
        <h1 class="bottom" aria-hidden="true"><span>Giovanny</span> Chica</h1>
      </section>
      <h3 class="">
        <FormattedText
          text={{
            es: "Soy de Medellín, Colombia, tengo experiencia como desarrollador de SOFTWARE. Soy una persona con muchas ganas de aprender y crecer en el área de desarrollo de software, que le gusta trabajar en equipo y es muy responsable con su trabajo, que le gusta aprender cosas nuevas cada día y siempre está dispuesto a ayudar a sus compañeros.",
            en: "I am from Medellín, Colombia, and I have experience as a SOFTWARE developer. I am a person eager to learn and grow in the software development field, who enjoys teamwork and is very responsible with their work, loves learning new things every day, and is always willing to help colleagues.",
          }}
        />
      </h3>
      <div class="box">
        <div class="red-social">
          <a
            href="https://www.linkedin.com/in/giovannyc-gil/"
            target="_blank"
            class="fa-brands fa-linkedin-in"></a>
          <a
            href="https://www.instagram.com/giovannychica/"
            target="_blank"
            class="fa fa-instagram"></a>
          <a
            href="https://wa.me/573043209834"
            target="_blank"
            class="fa-brands fa-whatsapp"></a>
          <a
            href="https://github.com/GiovannyGil/"
            target="_blank"
            class="fa-brands fa-github"></a>
          <a
            href="mailto:arvey950@gmail.com"
            target="_blank"
            class="fa-solid fa-envelope"></a>

          <a
            href="#"
            class="fa-solid fa-circle-info"
            title="original design of: web_devs__"></a>
        </div>
      </div>
    </div>
  </div>
</section>

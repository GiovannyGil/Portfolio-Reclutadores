---
import { LENGUAGES } from "./models/Lenguages.model.js";

import "/public/css/slide/style.css";

const allLanguages = [...LENGUAGES, ...LENGUAGES, ...LENGUAGES];
---

<div class="slider">
  <div class="slide-track">
    {
      allLanguages.map(({ Icon }) => (
        <div class="slide">
          <Icon class="imagenes" />
        </div>
      ))
    }
  </div>
</div>

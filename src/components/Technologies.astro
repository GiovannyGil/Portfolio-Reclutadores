---
// modelo/interface -> "tabla" de nivel de conocimiento

import { TECHNOLOGIES } from './models/Technologies.model.js'
---
<section class='stock-watchlist-container'>
    <h2 class="titulo">Techologies</h2>
    <div id="stocks">
        {
            TECHNOLOGIES.map(({Name, Level, clase, Icon}) => (
                <article class="stock-row">
                    <Icon class="stock-avatar"></Icon>
                    <div class="stock-name">
                        <h3>{Name}</h3>
                    </div>
                    
                    <div class="stock-info">
                        <p class="change" style={`background-color: ${clase};`}>{Level}</p>
                    </div>
                </article>
            ))
        }
    </div>
</section>
